; Exact pins only. A deterministic build starts with a deterministic dependency
; tree, and a range in package.json defeats it. GITHUB section 12.
save-exact=true

; Neither output belongs in a gate's log. Supply-chain review is Dependabot's
; weekly pull request, not a message printed during install. GITHUB section 12.
fund=false
audit=false

; An unsupported runtime REFUSES TO INSTALL rather than warning. Without this,
; npm prints a line nobody reads and the suite runs on a runtime its own test
; runner does not support: the gate then reports "it happened to work on this
; runner today", and the failure mode when it stops is a misbehaving tool rather
; than a clear refusal. Both CI jobs pin one Node version and package.json
; declares the supported range, so this makes the two agree or fail.
;
; THE RANGE IS THE ONE THE LOCKFILE ACTUALLY SUPPORTS, not a floor. Evaluating
; all 117 engines.node ranges in the committed lockfile leaves 0 unsatisfied on
; 20.19.0, 22.13.0 and 24.12.0 and 28, 27, 10, 31 and 11 unsatisfied on 20.18.0,
; 22.0.0, 22.12.0, 21.x and 23.x. Under a bare ">=20.19.0" a contributor on Node
; 21, on 22.0 to 22.12, or on 23 met a hard install refusal from a file that
; said their runtime was supported; "^20.19.0 || ^22.13.0 || >=24" says what is
; true. Re-derive it whenever the lockfile moves. GITHUB section 12.
engine-strict=true
